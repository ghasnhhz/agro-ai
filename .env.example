# ---- API (server-side only; never expose in client bundle) ----

# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (web dev server)
WEB_ORIGIN=http://localhost:5173

# Session signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram bot token from @BotFather.
# If left empty, the API runs in DEV AUTH mode (a mock user) so the app
# works in a plain browser. Set it for real in-Telegram initData validation.
BOT_TOKEN=

# Anthropic (Claude vision) for disease detection.
# If empty, /disease/analyze returns a graceful structured fallback.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-user/day cap on AI disease analyses (cost control)
DISEASE_DAILY_LIMIT=20

# Optional Postgres / Supabase. If empty, the API uses an in-memory seeded store.
DATABASE_URL=

# ---- Web (Vite) — only VITE_* vars reach the client bundle ----
VITE_API_BASE_URL=http://localhost:4000/api
